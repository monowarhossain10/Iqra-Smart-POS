Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|config|database|resources|storage)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.git|\.env(?:\..*)?|\.gitignore|bootstrap\.php|README\.md|DEPLOYMENT\.md|cookies\.txt)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "\.(?:env|log|sql|md|sqlite|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>